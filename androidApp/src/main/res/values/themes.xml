<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The final theme we use -->
    <style name="Theme.CasaVirupa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <style name="CasaVirupa.Theme.Splash" parent="Theme.SplashScreen">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="windowSplashScreenBackground">@color/primaryContainer</item>
    </style>

    <style name="Theme.CasaVirupa.Splash" parent="CasaVirupa.Theme.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/cv_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CasaVirupa</item>
    </style>
</resources>