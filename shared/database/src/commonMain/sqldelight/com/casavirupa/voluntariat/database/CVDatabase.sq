import kotlin.Boolean;

CREATE TABLE GoogleCalendarEventDb (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    googleId TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    start INTEGER NOT NULL,
    end INTEGER NOT NULL,
    isAllDay INTEGER AS Boolean NOT NULL
);

insertGoogleCalendarEvent:
INSERT OR REPLACE INTO GoogleCalendarEventDb VALUES (?, ?, ?, ?, ?, ?, ?);

-- Events overlapping [startTimestamp, endTimestamp): the window a sync is about to re-insert.
deleteGoogleCalendarEventsOverlapping:
DELETE FROM GoogleCalendarEventDb
WHERE start < :endTimestamp AND end > :startTimestamp;

deleteGoogleCalendarEventsEndingBefore:
DELETE FROM GoogleCalendarEventDb
WHERE end < :cutoff;

getGoogleCalendarEvents:
SELECT DISTINCT *
FROM GoogleCalendarEventDb;

getGoogleCalendarEventsByDate:
SELECT DISTINCT *
FROM GoogleCalendarEventDb
WHERE start < (:date + 86400000) AND end > :date;
